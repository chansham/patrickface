{
  "schemaVersion": 1,
  "description": "Shared synthetic state-machine scenarios. No health data, timer mutation, playback, or storage.",
  "cases": [
    {
      "id": "observed-completion-manual-one-shot",
      "actions": [
        {
          "op": "visibility",
          "nowMS": 1000,
          "active": true
        },
        {
          "op": "observe",
          "nowMS": 2000,
          "id": "session-a",
          "kind": "running",
          "status": "running"
        },
        {
          "op": "complete",
          "nowMS": 3000,
          "event": {
            "id": "session-a",
            "kind": "running",
            "status": "completed",
            "endedAtMS": 3000
          },
          "availableVariants": [
            "towel",
            "drink",
            "rest"
          ],
          "expected": {
            "phase": "offered",
            "reason": "completionObserved",
            "availableVariants": [
              "towel",
              "drink",
              "rest"
            ],
            "mode": "live",
            "variant": null
          }
        },
        {
          "op": "choose",
          "variant": "drink",
          "nowMS": 4000,
          "expected": {
            "phase": "playing",
            "variant": "drink",
            "reason": "userChoice"
          }
        },
        {
          "op": "finish",
          "nowMS": 5000,
          "expected": {
            "phase": "done",
            "reason": "finished"
          }
        },
        {
          "op": "complete",
          "nowMS": 6000,
          "event": {
            "id": "session-a",
            "kind": "running",
            "status": "completed",
            "endedAtMS": 3000
          },
          "availableVariants": [
            "towel",
            "drink",
            "rest"
          ],
          "expected": {
            "phase": "done",
            "reason": "finished"
          }
        },
        {
          "op": "choose",
          "variant": "towel",
          "nowMS": 7000,
          "expected": {
            "phase": "done",
            "variant": "drink"
          }
        }
      ]
    },
