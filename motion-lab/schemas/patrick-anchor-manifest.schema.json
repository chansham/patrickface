{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patrick-anchor-manifest.schema.json",
  "title": "Patrick Anchor Manifest",
  "type": "object",
  "required": ["id", "version", "coordinateSpace", "anchors", "layers"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "coordinateSpace": {
      "type": "object",
      "required": ["width", "height", "origin"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "const": "top-left" }
      }
    },
    "anchors": {
      "type": "object",
      "required": ["characterRoot", "hourArmPivot", "minuteArmPivot", "faceRoot"],
      "additionalProperties": {
        "type": "array",
        "prefixItems": [{ "type": "number" }, { "type": "number" }],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "z"],
        "properties": {
          "id": { "type": "string" },
          "z": { "type": "number" },
          "asset": { "type": ["string", "null"] }
        }
      }
    }
  }
}
